TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_API_BASE=https://api.telegram.org
REACT_APP_LANGUAGE_STORAGE_KEY=sushi-love-lang
# Кошик у localStorage (опційно; інакше ключ sushi-love-cart):
# REACT_APP_CART_STORAGE_KEY=sushi-love-cart

# Resend — лист клієнту: після «Прийняти» + ETA, або після «Відхилити»:
# https://resend.com — створи API key у дашборді.
RESEND_API_KEY=re_xxxxxxxx
#
# Без свого домену — тимчасово для тестів (офіційний приклад Resend):
RESEND_FROM="Sushi Love <onboarding@resend.dev>"
# Обмеження: без верифікованого домену Resend дозволяє не всі адреси «to» — перевір у документації / дашборді.
# Коли буде домен (наприклад після купівлі .pl і DNS у Resend), заміни на:
# RESEND_FROM="Sushi Love <orders@twoja-domena.pl>"
# RESEND_SUBJECT_CONFIRMED=...  (опційно)
# RESEND_SUBJECT_REJECTED=...   (опційно — лист після «Відхилити»)

# Webhook для кнопок у Telegram (Прийняти → час → лист):
# 1) Згенеруй випадковий рядок для TELEGRAM_WEBHOOK_SECRET (довгий).
# 2) Додай у Netlify Environment: TELEGRAM_WEBHOOK_SECRET і (опційно) TELEGRAM_ADMIN_IDS=123,456
#    (telegram user id через кому — тільки вони зможуть натискати кнопки; якщо порожньо — усі в чаті).
# 3) У браузері відкрий (підстав свій домен і токен):
# https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<твій-сайт>.netlify.app/.netlify/functions/telegram-webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
#    Не обмежуй allowed_updates лише "message" — для кнопок потрібен тип callback_query (краще не передавати allowed_updates взагалі).
# 4) deleteWebhook потрібен, якщо раніше використовував getUpdates (polling).

# Локально: npm run dev — сайт http://localhost:3000, functions через проксі (setupProxy.js).
# Не вставляй справжній токен у цей файл; копіюй як .env і тримай .env поза git.
