{
  "name": "sushi-love-site",
  "version": "1.0.0",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "npx --yes concurrently@8.2.2 -k \"npx --yes netlify-cli functions:serve --port 9999\" \"BROWSER=none react-scripts start\"",
    "dev:netlify": "BROWSER=none npx --yes netlify-cli dev --no-open",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
